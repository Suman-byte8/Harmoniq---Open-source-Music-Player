# Copy to .env. All values are optional; defaults shown. No secrets are required.
PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed by CORS. Unset = any origin (native apps are unaffected).
CORS_ORIGIN=

# Binaries used to reach upstream metadata/stream providers
PYTHON_BIN=python
YTDLP_BIN=yt-dlp

# Process pool limits (each cache miss spawns one process)
MAX_CONCURRENT_PROCESSES=4
MAX_QUEUED_PROCESSES=50
PROCESS_TIMEOUT_MS=30000

# Long-lived Python worker (fast). Set false to spawn one process per request.
PYTHON_WORKER=true
# Pre-fill trending cache at boot and every 25 min.
WARM_CACHE=true
